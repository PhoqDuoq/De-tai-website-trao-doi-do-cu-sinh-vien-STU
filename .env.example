# ========================================================
# STU Marketplace - Monorepo Environment Configuration
# ========================================================

# --- General System Environment ---
APP_ENV=development
APP_TIMEZONE=Asia/Ho_Chi_Minh

# --- Service Port Allocation ---
GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
LISTING_SERVICE_PORT=8082
INTERACTION_SERVICE_PORT=8083
TRANSACTION_SERVICE_PORT=8084
MODERATION_SERVICE_PORT=8085
BILLING_SERVICE_PORT=8086
FRONTEND_PORT=5173

# --- API Gateway Service Route URLs ---
IDENTITY_SERVICE_URL=http://localhost:8081
LISTING_SERVICE_URL=http://localhost:8082
INTERACTION_SERVICE_URL=http://localhost:8083
TRANSACTION_SERVICE_URL=http://localhost:8084
MODERATION_SERVICE_URL=http://localhost:8085
BILLING_SERVICE_URL=http://localhost:8086

# --- WampServer MySQL Database Credentials (Port 3306) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# --- Independent Database Connection Strings ---
# Architectural Rule (R3): Strict database isolation. 
# Zero cross-database foreign keys, zero cross-database SQL joins.
DB_IDENTITY_URL=jdbc:mysql://localhost:3306/stu_identity_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_LISTING_URL=jdbc:mysql://localhost:3306/stu_listing_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_INTERACTION_URL=jdbc:mysql://localhost:3306/stu_interaction_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_TRANSACTION_URL=jdbc:mysql://localhost:3306/stu_transaction_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_MODERATION_URL=jdbc:mysql://localhost:3306/stu_moderation_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_BILLING_URL=jdbc:mysql://localhost:3306/stu_billing_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# --- JWT Authentication & Security ---
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# --- File Storage & Uploads ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB

# --- Frontend Gateway Base URL ---
VITE_API_BASE_URL=http://localhost:8080
